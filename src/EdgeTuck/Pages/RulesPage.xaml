<Page x:Class="EdgeTuck.Pages.RulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:EdgeTuck.Shell"
      xmlns:f="clr-namespace:EdgeTuck.Features">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24" MaxWidth="900">
            <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T Page.Rules}" />
            <ui:TextBlock Appearance="Secondary" Text="{l:T Rules.Subtitle}" Margin="0,4,0,16" TextWrapping="Wrap" />
            <ui:Card x:Name="EmptyCard" Margin="0,0,0,4">
                <ui:TextBlock Appearance="Tertiary" Text="{l:T Rules.Empty}" TextWrapping="Wrap" />
            </ui:Card>
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type f:Rule}">
                        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon AppsListDetail24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock Text="{Binding Exe}" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="{Binding Detail}" FontTypography="Caption" Appearance="Secondary" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch IsChecked="{Binding AutoTuck}" Content="{l:T Rules.AutoTuck}" Margin="0,0,24,0" />
                                <ui:ToggleSwitch IsChecked="{Binding Enabled}" Content="{l:T Rules.Enabled}" Margin="0,0,16,0" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:T Rules.Delete}" Click="OnDelete" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
