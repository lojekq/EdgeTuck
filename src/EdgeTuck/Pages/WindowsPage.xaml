<Page x:Class="EdgeTuck.Pages.WindowsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:EdgeTuck.Shell"
      xmlns:f="clr-namespace:EdgeTuck.Features">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24" MaxWidth="900">
            <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T Page.Windows}" />
            <ui:TextBlock Appearance="Secondary" Text="{l:T Windows.Subtitle}" Margin="0,4,0,16" TextWrapping="Wrap" />
            <ui:InfoBar x:Name="PausedBar" Severity="Warning" IsClosable="False" Title="{l:T Windows.Paused}" Margin="0,0,0,8">
                <ui:Button x:Name="ResumeButton" Content="{l:T Windows.Resume}" />
            </ui:InfoBar>
            <ui:Card x:Name="EmptyCard" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PanelLeftContract24" FontSize="28" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:TextBlock Appearance="Tertiary" Text="{l:T Windows.Empty}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type f:Tucked}">
                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Icon>
                                <ui:ImageIcon Source="{Binding Icon}" Width="24" Height="24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
                                    <ui:TextBlock Text="{Binding Detail}" FontTypography="Caption" Appearance="Secondary" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="{l:T Windows.Show}" Icon="{ui:SymbolIcon Eye24}" Margin="0,0,8,0" Click="OnShow" />
                                <ui:Button Content="{l:T Windows.Return}" Icon="{ui:SymbolIcon ArrowExportLtr24}" Margin="0,0,8,0" Click="OnReturn" />
                                <ui:Button Content="{l:T Windows.Remember}" Icon="{ui:SymbolIcon Pin24}" Click="OnRemember" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
